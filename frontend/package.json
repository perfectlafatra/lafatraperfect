{
  "name": "lafatraperfect-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node tools/generate-static-routes.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "check:links": "node tools/check-links.mjs",
    "check:contract": "node tools/check-public-contract.mjs",
    "check:routes": "node tools/check-static-routes.mjs",
    "sitemap": "node tools/generate-sitemap.mjs",
    "verify": "npm run lint && npm run test:run && npm run build && npm run check:links && npm run check:contract && npm run check:routes"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "i18next": "25.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.3.5",
    "react-router-dom": "6.30.6",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.12",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "postcss": "^8.5.30",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
